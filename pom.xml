<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.3</version>
    <relativePath/>
  </parent>

  <groupId>com.quantanaut</groupId>
  <artifactId>benefits-test-app</artifactId>
  <version>1.0.0</version>
  <name>Benefits Test Application</name>
  <description>Benefits enrolment service. Reference workload for cryptographic posture assessment.</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <!-- Source of record for the binary→repository correlation. A build without
       this block can only be matched on coordinates, which is a weaker claim. -->
  <scm>
    <connection>scm:git:https://github.com/cyberzero-inc/benefits-test-app.git</connection>
    <url>https://github.com/cyberzero-inc/benefits-test-app</url>
  </scm>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- Pinned to 1.77. 1.78 is the first release with the NIST-final
         parameter sets; see docs/PQC-ROADMAP.md item R-2. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>1.77</version>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>1.77</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <!-- Carried into the artifact so a shipped binary can be tied to
                   the exact commit it was built from, not merely to its GAV. -->
              <Implementation-SCM-Url>https://github.com/cyberzero-inc/benefits-test-app</Implementation-SCM-Url>
              <Implementation-SCM-Revision>${buildNumber}</Implementation-SCM-Revision>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
