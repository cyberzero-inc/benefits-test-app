<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE web-app
    PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
    "http://java.sun.com/dtd/web-app_2_3.dtd">

<web-app>
  <display-name>ACME Benefits Enrollment</display-name>

  <servlet>
    <servlet-name>login</servlet-name>
    <servlet-class>com.acme.benefits.servlet.LoginServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>enroll</servlet-name>
    <servlet-class>com.acme.benefits.servlet.EnrollmentServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>login</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>enroll</servlet-name>
    <url-pattern>/enroll</url-pattern>
  </servlet-mapping>

  <session-config>
    <session-timeout>30</session-timeout>
  </session-config>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>
</web-app>
