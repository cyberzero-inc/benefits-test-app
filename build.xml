<?xml version="1.0"?>
<!-- Benefits system build. R. Whitfield, 1998. Updated for Ant 1.6, 2004. -->
<project name="benefits" default="war" basedir=".">

  <property name="src.dir"     value="src"/>
  <property name="build.dir"   value="build"/>
  <property name="dist.dir"    value="dist"/>
  <property name="lib.dir"     value="lib"/>
  <property name="web.dir"     value="WebContent"/>
  <property name="app.version" value="4.2.1"/>

  <path id="compile.classpath">
    <fileset dir="${lib.dir}">
      <include name="*.jar"/>
    </fileset>
  </path>

  <target name="clean">
    <delete dir="${build.dir}"/>
    <delete dir="${dist.dir}"/>
  </target>

  <target name="compile">
    <mkdir dir="${build.dir}/classes"/>
    <javac srcdir="${src.dir}"
           destdir="${build.dir}/classes"
           source="1.4"
           target="1.4"
           debug="on"
           deprecation="off">
      <classpath refid="compile.classpath"/>
    </javac>
  </target>

  <target name="war" depends="compile">
    <mkdir dir="${dist.dir}"/>
    <war destfile="${dist.dir}/benefits-${app.version}.war"
         webxml="${web.dir}/WEB-INF/web.xml">
      <classes dir="${build.dir}/classes"/>
      <lib dir="${lib.dir}">
        <include name="*.jar"/>
      </lib>
      <fileset dir="${web.dir}">
        <exclude name="WEB-INF/web.xml"/>
      </fileset>
      <webinf dir="conf">
        <include name="benefits.properties"/>
      </webinf>
    </war>
  </target>
</project>
